# =============================================================================
# Alexa+ Environment Configuration Template
# =============================================================================
# Architecture:
# Alexa+ runs completely ZERO-KEY out of the box using a self-hosted Model Context
# Protocol (MCP) server on port 3001 and local SQLite storage. No paid API keys
# are required to start or verify the application.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. RUNTIME-DERIVED VARIABLES (Automatically supplied by Render / Cloud)
# -----------------------------------------------------------------------------
# Render automatically injects PORT (e.g., 10000). The server binds to 0.0.0.0:$PORT.
PORT=3000

# Host binding: 0.0.0.0 is required for public cloud container ingress
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# 2. REQUIRED SERVICE CONFIGURATION (Defaults provided in code)
# -----------------------------------------------------------------------------
# Internal MCP server port (private to the container, not exposed publicly)
MCP_PORT=3001

# Database path (ephemeral on Render Free; automatically seeded on startup)
ALEXA_DB_PATH=alexa_plus.db

# -----------------------------------------------------------------------------
# 3. OPTIONAL: AWS BUILDER MINI-CHALLENGE (Amazon Bedrock)
# -----------------------------------------------------------------------------
# Leave empty to run with the built-in deterministic Autonomous Decision Engine.
# When provided, Alexa+ routes LLM tool planning through ConverseCommand.
# Supported Models:
#   - anthropic.claude-3-5-sonnet-20241022-v2:0
#   - amazon.nova-pro-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# 4. OPTIONAL: OPENAI-COMPATIBLE PROVIDER
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# 5. REAL OAUTH INTEGRATIONS (Google Workspace & Microsoft 365)
# -----------------------------------------------------------------------------
# Production Public Base URL (for callback redirect resolution)
PUBLIC_BASE_URL=https://alexa-beta.onrender.com

# AES-256-GCM encryption key for stored OAuth access & refresh tokens (32 bytes hex or base64)
OAUTH_TOKEN_ENCRYPTION_KEY=

# Google Cloud OAuth 2.0 Client credentials (Google Calendar, Gmail, Google Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://alexa-beta.onrender.com/api/integrations/google/callback

# Microsoft Entra ID App credentials (Outlook Mail, Microsoft 365 Calendar)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://alexa-beta.onrender.com/api/integrations/microsoft/callback

# -----------------------------------------------------------------------------
# 6. DEVELOPMENT-ONLY VARIABLES (Not used in production on Render)
# -----------------------------------------------------------------------------
VITE_PORT=5173

